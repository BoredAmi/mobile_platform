<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>jgb_rover_temperature</name>
  <version>0.1.0</version>
  <description>MCP9808 temperature sensor for jgb_rover: I2C driver, simulated sensor, and a temperature heatmap built in the map frame.</description>
  <maintainer email="azmozgame@gmail.com">ami</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>jgb_rover_control</exec_depend>
  <exec_depend>jgb_rover_description</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- real robot only: python3-smbus2 (apt) for mcp9808_driver -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
