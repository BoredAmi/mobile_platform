Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Help Height: 0
    Splitter Ratio: 0.55
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: map
    Background Color: 48; 48; 48
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: map
      Cell Size: 1
      Plane Cell Count: 14
      Color: 110; 110; 110
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 1
      Alpha: 0.8
      Color Scheme: map
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: false
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.3
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: Visual scan
      Enabled: true
      Topic:
        Value: /visual_scan
        Reliability Policy: Best Effort
        Depth: 5
      Style: Points
      Size (Pixels): 4
      Size (m): 0.03
      Color Transformer: FlatColor
      Color: 255; 60; 60
      Alpha: 1
      Value: true
    - Class: rviz_default_plugins/Path
      Name: EKF path
      Enabled: true
      Topic:
        Value: /path/ekf
      Line Style: Lines
      Color: 30; 200; 120
      Alpha: 1
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Ground-truth path
      Enabled: true
      Topic:
        Value: /path/ground_truth
      Line Style: Lines
      Color: 240; 240; 240
      Alpha: 0.8
      Value: true
    - Class: rviz_default_plugins/PoseArray
      Name: ArUco markers
      Enabled: true
      Topic:
        Value: /aruco/poses
      Shape: Axes
      Axes Length: 0.15
      Axes Radius: 0.01
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Floor scan debug
      Enabled: true
      Topic:
        Value: /visual_scan/debug
        Reliability Policy: Best Effort
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Camera
      Enabled: false
      Topic:
        Value: /camera/image_raw
        Reliability Policy: Best Effort
      Value: false
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 90
      X: 1
      Y: 0
Window Geometry:
  Width: 1500
  Height: 950
