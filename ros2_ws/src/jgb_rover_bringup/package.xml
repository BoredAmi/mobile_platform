<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>jgb_rover_bringup</name>
  <version>0.1.0</version>
  <description>Top-level launch files and evaluation scripts for jgb_rover.</description>
  <maintainer email="azmozgame@gmail.com">ami</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>jgb_rover_description</exec_depend>
  <exec_depend>jgb_rover_gazebo</exec_depend>
  <exec_depend>jgb_rover_control</exec_depend>
  <exec_depend>jgb_rover_hardware</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>jgb_rover_localization</exec_depend>
  <exec_depend>jgb_rover_perception</exec_depend>
  <exec_depend>jgb_rover_temperature</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
