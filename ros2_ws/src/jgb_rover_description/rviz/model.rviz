Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Cell Size: 0.05
      Plane Cell Count: 20
      Reference Frame: base_footprint
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel (visual)
      Description Topic:
        Value: /robot_description
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 0.6
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel (collision)
      Description Topic:
        Value: /robot_description
      Visual Enabled: false
      Collision Enabled: true
      Alpha: 0.4
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Marker Scale: 0.1
      Show Names: true
      Value: true
  Global Options:
    Fixed Frame: base_footprint
    Background Color: 48; 48; 48
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 0.9
      Focal Point: {X: 0, Y: 0, Z: 0.12}
      Pitch: 0.45
      Yaw: 0.8
